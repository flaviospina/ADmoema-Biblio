# ---------- Banco de dados ----------
# SQLite por padrao (arquivo local). Para Postgres, troque o provider em
# prisma/schema.prisma para "postgresql" e ajuste a URL abaixo.
DATABASE_URL="file:./dev.db"

# ---------- Autenticacao ----------
# Chave para assinar os tokens de sessao (JWT). Gere uma forte, ex.:
#   openssl rand -base64 32
AUTH_SECRET=

# E-mails que devem ser ADMIN ao se registrar (separados por virgula).
# Obs.: o PRIMEIRO usuario a se cadastrar ja vira ADMIN automaticamente.
ADMIN_EMAILS=

# ---------- OpenAI (geracao da letra + estilo) ----------
OPENAI_API_KEY=sk-...
# Modelo opcional (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ---------- Suno (geracao da musica) ----------
# O Suno nao tem API oficial publica. Use um provedor compativel
# (ex.: https://sunoapi.org) e cole a chave abaixo.
SUNO_API_KEY=
SUNO_API_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V4

# Modo mock: deixe "1" para rodar sem chave do Suno (usa uma faixa de exemplo).
# Se SUNO_API_KEY estiver vazio, o mock e ativado automaticamente.
SUNO_MOCK=1
