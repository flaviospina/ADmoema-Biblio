# Coral ADMoema — URLs amigáveis (HostGator / Apache)
# Funciona na raiz OU em subpasta (ex.: admoema.com.br/coral) sem ajustes:
# os caminhos abaixo são relativos à pasta onde este arquivo está.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloqueia acesso direto a pastas internas e arquivos sensíveis
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule ^uploads(/|$) - [F,L]
  RewriteRule ^config(\.example)?\.php$ - [F,L]

  # Arquivos e pastas reais (assets) são servidos diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto passa pelo front controller DESTA pasta
  RewriteRule ^ index.php [L]
</IfModule>

# Segurança básica
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
